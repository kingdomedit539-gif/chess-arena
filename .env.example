# ---------------------------------------------------------------------------
# Chess Arena — environment
# Copy to `.env.local` (Next reads it) and/or `.env` (custom server reads it).
# ---------------------------------------------------------------------------

# Port for the combined Next + Socket.io server
PORT=3000
HOSTNAME=0.0.0.0

# Milliseconds a disconnected player has to reconnect before losing on time.
RECONNECT_GRACE_MS=30000

# Optional: absolute path/URL used FIRST when booting Stockfish. Leave empty to
# use the bundled local build (public/engine/stockfish.js) + CDN fallbacks.
NEXT_PUBLIC_STOCKFISH_URL=

# Optional: default search depth for post-game review (12 = fast, 18 = strong)
NEXT_PUBLIC_REVIEW_DEPTH=14

# --- Optional Supabase persistence (see supabase/schema.sql) -----------------
# When both values are present the server persists players/games to Supabase
# instead of the local JSON files. The realtime layer can stay on socket.io.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
